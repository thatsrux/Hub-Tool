   <Setter Property="Foreground" Value="#E8EFF8"/><Setter Property="Background" Value="#101B2B"/><Setter Property="Margin" Value="4,8"/><Setter Property="MinHeight" Value="38"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>

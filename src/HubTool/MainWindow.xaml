<Window x:Class="HubTool.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="Hub Tool" Width="1100" Height="770" MinWidth="900" MinHeight="620" WindowStartupLocation="CenterScreen">
 <Grid Margin="22,16,22,12">
  <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,12">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Aggiorna" Click="RefreshClick" Padding="14,6"/><Button x:Name="OverlayToggle" Content="Overlay" Click="OverlayClick" Padding="14,6" Style="{StaticResource AccentButton}"/></StackPanel>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Background="#19423C" CornerRadius="8" Width="32" Height="32"><TextBlock Text="H" Foreground="{StaticResource Accent}" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Hub Tool" FontSize="22" FontWeight="SemiBold" Margin="10,0" VerticalAlignment="Center"/><TextBlock Text="0.3" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></StackPanel>
  </DockPanel>
  <TabControl x:Name="Pages" Grid.Row="1" Background="Transparent" BorderThickness="0">
   <TabItem Header="Dispositivi"><Grid Margin="0,14,0,0"><Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="58"/><RowDefinition/></Grid.RowDefinitions>
    <UniformGrid Columns="3" Margin="0,0,-10,10">
     <Border Style="{StaticResource StatCard}"><StackPanel Orientation="Horizontal"><TextBlock x:Name="ConnectedCount" Text="—" Style="{StaticResource StatValue}"/><TextBlock Text="Collegati" Style="{StaticResource StatLabel}"/></StackPanel></Border>
     <Border Style="{StaticResource StatCard}"><StackPanel Orientation="Horizontal"><TextBlock x:Name="OverlayCount" Text="—" Style="{StaticResource StatValue}"/><TextBlock Text="Nell’overlay" Style="{StaticResource StatLabel}"/></StackPanel></Border>
     <Border Style="{StaticResource StatCard}"><StackPanel Orientation="Horizontal"><TextBlock x:Name="ProfileCount" Text="—" Style="{StaticResource StatValue}"/><TextBlock Text="Profili salvati" Style="{StaticResource StatLabel}"/></StackPanel></Border>
    </UniformGrid>
    <Grid Grid.Row="1" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="160"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Grid><TextBox x:Name="Search" TextChanged="SearchChanged" AutomationProperties.Name="Cerca periferica" Margin="0,0,10,0" VerticalContentAlignment="Center"/><TextBlock Text="Cerca periferica…" Foreground="{StaticResource Muted}" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text.Length, ElementName=Search}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
     <ComboBox x:Name="CategoryFilter" Grid.Column="1" SelectedIndex="0" SelectionChanged="CategoryChanged" Margin="0,0,10,0" AutomationProperties.Name="Categoria"><ComboBoxItem Content="Tutti"/><ComboBoxItem Content="Audio"/><ComboBoxItem Content="Microfoni"/><ComboBoxItem Content="Input"/><ComboBoxItem Content="Monitor"/><ComboBoxItem Content="Videocamere"/><ComboBoxItem Content="USB e altro"/></ComboBox>
     <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><CheckBox x:Name="OnlyControllable" Content="Con controlli" Click="FilterChanged"/><CheckBox x:Name="ShowDisconnected" Content="Scollegati" IsChecked="True" Click="FilterChanged"/></StackPanel>
    </Grid>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="318"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Grid Margin="0,0,14,0"><Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition/></Grid.RowDefinitions><TextBlock x:Name="DeviceCount" Foreground="{StaticResource Muted}" FontSize="11"/>
      <ListBox x:Name="DeviceList" Grid.Row="1" SelectionChanged="SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
       <ListBox.ItemTemplate><DataTemplate><Grid Margin="11,12"><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border Width="30" Height="34" VerticalAlignment="Top"><Viewbox Width="23" Height="23"><Path Data="{Binding IconGeometry}" Stroke="{Binding IconBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="25" Height="25" Stretch="Uniform"/></Viewbox></Border>
        <StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" ToolTip="{Binding Name}"/><TextBlock Text="{Binding TypeLabel}" Foreground="{Binding IconBrush}" FontSize="11" Margin="0,4,0,2"/><TextBlock Text="{Binding Status}" Foreground="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap"/></StackPanel>
       </Grid></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
     </Grid>
     <Border Grid.Column="1" Style="{StaticResource SectionCard}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Details"/></ScrollViewer></Border>
    </Grid>
   </Grid></TabItem>
   <TabItem Header="Profili"><Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="370"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource SectionCard}" Margin="0,0,14,0"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
     <TextBlock Text="Nuovo profilo" Style="{StaticResource SectionTitle}"/><TextBlock Text="Salva le impostazioni attuali delle periferiche." Style="{StaticResource Hint}"/>
     <TextBlock Text="Nome" Margin="0,14,0,0"/><TextBox x:Name="ProfileName" Text="Il mio profilo" AutomationProperties.Name="Nome profilo"/>
     <Button Content="Salva profilo" Click="SaveProfile" Style="{StaticResource AccentButton}"/>
     <Separator Margin="0,22" Background="#304155"/>
     <TextBlock Text="Profili salvati" Style="{StaticResource SectionTitle}"/><ComboBox x:Name="Profiles" SelectionChanged="ProfileSelected" AutomationProperties.Name="Profilo selezionato"/>
     <Button Content="Applica profilo" Click="ApplyProfile"/><UniformGrid Columns="2"><Button Content="Importa…" Click="ImportProfile"/><Button Content="Esporta…" Click="ExportProfile"/></UniformGrid><Button Content="Elimina selezionato" Click="DeleteProfile"/>
    </StackPanel></ScrollViewer></Border>
    <Border Grid.Column="1" Style="{StaticResource SectionCard}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Impostazioni incluse" Style="{StaticResource SectionTitle}"/><StackPanel x:Name="ProfileSummary" Margin="0,12,0,0"><TextBlock Text="Seleziona o salva un profilo per vedere le impostazioni." Style="{StaticResource Hint}"/></StackPanel></StackPanel></ScrollViewer></Border>
   </Grid></TabItem>
   <TabItem Header="Shortcut"><Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="440"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource SectionCard}" Margin="0,0,14,0"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
     <TextBlock Text="Nuova shortcut" Style="{StaticResource SectionTitle}"/><TextBlock Text="Combinazione" Margin="0,16,0,0"/><TextBox x:Name="Gesture" Text="Ctrl+Alt+M" AutomationProperties.Name="Combinazione shortcut"/>
     <TextBlock Text="Azione"/><ComboBox x:Name="ActionChoice" DisplayMemberPath="Label" SelectionChanged="ActionChanged" AutomationProperties.Name="Azione shortcut"/>
     <StackPanel x:Name="ValuePanel" Visibility="Collapsed"><TextBlock Text="Valore"/><TextBox x:Name="ActionValue" Text="50"/></StackPanel>
     <StackPanel x:Name="LaunchPanel" Visibility="Collapsed"><TextBlock Text="File o programma"/><TextBox x:Name="LaunchTarget"/><Button Content="Sfoglia…" Click="BrowseProgram"/><TextBlock Text="Argomenti (facoltativi)"/><TextBox x:Name="LaunchArguments"/></StackPanel>
     <Button Content="Registra shortcut" Click="AddShortcut" Style="{StaticResource AccentButton}"/>
     <TextBlock Text="Le combinazioni già usate da altre app vengono segnalate." Style="{StaticResource Hint}" Margin="0,12,0,0"/>
    </StackPanel></ScrollViewer></Border>
    <Border Grid.Column="1" Style="{StaticResource SectionCard}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Shortcut registrate" Style="{StaticResource SectionTitle}"/><ListBox x:Name="Shortcuts" Grid.Row="1" Margin="0,12,0,12"/><Button Grid.Row="2" Content="Rimuovi selezionata" Click="RemoveShortcut" HorizontalAlignment="Left"/></Grid></Border>
   </Grid></TabItem>
   <TabItem Header="Windows"><Border Style="{StaticResource SectionCard}" Margin="0,14,0,0"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock Text="Impostazioni Windows" Style="{StaticResource SectionTitle}"/>
    <UniformGrid Columns="2" Margin="0,12,0,0"><Button Content="Mouse e puntatore" Tag="ms-settings:mousetouchpad" Click="OpenSettings"/><Button Content="Tastiera e accessibilità" Tag="ms-settings:easeofaccess-keyboard" Click="OpenSettings"/><Button Content="Bluetooth e dispositivi" Tag="ms-settings:bluetooth" Click="OpenSettings"/><Button Content="Audio e mixer" Tag="ms-settings:apps-volume" Click="OpenSettings"/><Button Content="Schermi" Tag="ms-settings:display" Click="OpenSettings"/><Button Content="Videocamere" Tag="ms-settings:camera" Click="OpenSettings"/><Button Content="Stampanti" Tag="ms-settings:printers" Click="OpenSettings"/><Button Content="Gaming" Tag="ms-settings:gaming-gamebar" Click="OpenSettings"/></UniformGrid>
    <Separator Margin="0,22" Background="#304155"/><TextBlock Text="Dati e applicazione" Style="{StaticResource SectionTitle}"/><Button Content="Apri cartella impostazioni" Click="OpenData" HorizontalAlignment="Left"/>
    <TextBlock Text="Chiudendo la finestra, Hub resta nell’area notifiche." Style="{StaticResource Hint}" Margin="4,8"/>
    <Button Content="Esci da Hub" Click="ExitHub" HorizontalAlignment="Left"/>
   </StackPanel></ScrollViewer></Border></TabItem>
  </TabControl>
  <TextBlock x:Name="Status" Grid.Row="2" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,10,0,0" Text="Rilevamento…" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
 </Grid>
</Window>

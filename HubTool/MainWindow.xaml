<Window x:Class="HubTool.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="Hub Tool" Width="1120" Height="780" MinWidth="900" MinHeight="620" WindowStartupLocation="CenterScreen">
 <Grid Margin="28">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="H U B   /   IL TUO SPAZIO DI CONTROLLO" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="Bold"/><TextBlock Text="Tutto a portata di mano." FontWeight="SemiBold" FontSize="30" Margin="0,6,0,4"/><TextBlock Text="Un posto per i tuoi dispositivi. Un profilo per ogni momento." Foreground="{StaticResource Muted}"/></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="↻  Aggiorna" Click="RefreshClick"/><Button Content="↗  Apri overlay" Click="OverlayClick" Style="{StaticResource AccentButton}"/></StackPanel>
  </Grid>
  <TabControl x:Name="Pages" Grid.Row="1" Background="Transparent" BorderThickness="0">
   <TabItem Header="Dispositivi"><Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="340"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="{StaticResource Panel}" CornerRadius="12" Padding="12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
     <TextBox x:Name="Search" TextChanged="SearchChanged" ToolTip="Cerca nome o categoria" AutomationProperties.Name="Cerca dispositivi"/>
     <WrapPanel Grid.Row="1"><CheckBox x:Name="OnlyControllable" Content="Con controlli" Click="FilterChanged"/><CheckBox x:Name="ShowDisconnected" Content="Anche scollegati" IsChecked="True" Click="FilterChanged"/></WrapPanel>
     <TextBlock x:Name="DeviceCount" Grid.Row="2" Foreground="{StaticResource Muted}" Margin="6,10" FontSize="11"/>
     <ListBox x:Name="DeviceList" Grid.Row="3" SelectionChanged="SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
      <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="8,9"><TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Text="{Binding Kind}" Foreground="{StaticResource Accent}" FontSize="11" Margin="0,4,0,0"/><TextBlock Text="{Binding Status}" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </Grid></Border>
    <Border Grid.Column="1" Background="{StaticResource Panel}" CornerRadius="12" Margin="18,0,0,0" Padding="24"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Details"/></ScrollViewer></Border>
   </Grid></TabItem>
   <TabItem Header="Profili"><Border TextElement.Foreground="#E8EFF8" Background="{StaticResource Panel}" CornerRadius="12" Margin="0,18,0,0" Padding="28"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="650" HorizontalAlignment="Left">
    <TextBlock Text="Un ambiente per ogni momento" FontSize="25" FontWeight="SemiBold"/>
    <TextBlock Text="Audio, canali, mouse, tastiera e monitor supportati. I dispositivi assenti mantengono le impostazioni da applicare alla riconnessione." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,12,0,22"/>
    <TextBlock Text="NOME DEL NUOVO PROFILO" FontSize="11" Foreground="{StaticResource Accent}"/>
    <TextBox x:Name="ProfileName" Text="Il mio profilo" AutomationProperties.Name="Nome profilo"/>
    <Button Content="＋  Salva le impostazioni attuali" Click="SaveProfile" HorizontalAlignment="Left" Style="{StaticResource AccentButton}"/>
    <Separator Margin="0,22" Background="#304155"/>
    <TextBlock Text="I TUOI PROFILI" FontSize="11" Foreground="{StaticResource Accent}"/>
    <ComboBox x:Name="Profiles" MinWidth="300" AutomationProperties.Name="Profilo selezionato"/>
    <WrapPanel><Button Content="Applica profilo" Click="ApplyProfile"/><Button Content="Elimina selezionato" Click="DeleteProfile"/></WrapPanel>
   </StackPanel></ScrollViewer></Border></TabItem>
   <TabItem Header="Shortcut"><Border TextElement.Foreground="#E8EFF8" Background="{StaticResource Panel}" CornerRadius="12" Margin="0,18,0,0" Padding="28"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock Text="Il controllo, senza interromperti" FontSize="25" FontWeight="SemiBold"/>
    <TextBlock Text="Scegli un’azione e una combinazione. I conflitti con altre app vengono segnalati." Foreground="{StaticResource Muted}" Margin="0,12,0,20" TextWrapping="Wrap"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="COMBINAZIONE" FontSize="11" Foreground="{StaticResource Accent}"/><TextBox x:Name="Gesture" Text="Ctrl+Alt+M" AutomationProperties.Name="Combinazione shortcut"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="AZIONE" FontSize="11" Foreground="{StaticResource Accent}"/><ComboBox x:Name="ActionChoice" DisplayMemberPath="Label" SelectionChanged="ActionChanged" AutomationProperties.Name="Azione shortcut"/></StackPanel></Grid>
    <StackPanel x:Name="ValuePanel" Visibility="Collapsed"><TextBlock Text="Valore da impostare"/><TextBox x:Name="ActionValue" Text="50" Width="160" HorizontalAlignment="Left"/></StackPanel>
    <StackPanel x:Name="LaunchPanel" Visibility="Collapsed"><TextBlock Text="File o programma"/><DockPanel><Button Content="Sfoglia…" DockPanel.Dock="Right" Click="BrowseProgram"/><TextBox x:Name="LaunchTarget"/></DockPanel><TextBlock Text="Argomenti facoltativi del programma"/><TextBox x:Name="LaunchArguments"/></StackPanel>
    <Button Content="＋  Registra shortcut" Click="AddShortcut" HorizontalAlignment="Left" Style="{StaticResource AccentButton}"/>
    <TextBlock Text="SHORTCUT ATTIVE" FontSize="11" Foreground="{StaticResource Accent}" Margin="0,24,0,10"/>
    <ListBox x:Name="Shortcuts" MinHeight="90" MaxHeight="220"/>
    <Button Content="Rimuovi selezionata" Click="RemoveShortcut" HorizontalAlignment="Left"/>
   </StackPanel></ScrollViewer></Border></TabItem>
   <TabItem Header="Sistema"><Border TextElement.Foreground="#E8EFF8" Background="{StaticResource Panel}" CornerRadius="12" Margin="0,18,0,0" Padding="28"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock Text="Il resto del tuo PC, a un clic" FontSize="25" FontWeight="SemiBold"/>
    <TextBlock Text="Apri i pannelli Windows per le funzioni gestite dal sistema e dai driver." Foreground="{StaticResource Muted}" Margin="0,12,0,22"/>
    <UniformGrid Columns="2"><Button Content="Mouse e puntatore" Tag="ms-settings:mousetouchpad" Click="OpenSettings"/><Button Content="Tastiera e accessibilità" Tag="ms-settings:easeofaccess-keyboard" Click="OpenSettings"/><Button Content="Bluetooth e dispositivi" Tag="ms-settings:bluetooth" Click="OpenSettings"/><Button Content="Audio e mixer applicazioni" Tag="ms-settings:apps-volume" Click="OpenSettings"/><Button Content="Schermi" Tag="ms-settings:display" Click="OpenSettings"/><Button Content="Gaming" Tag="ms-settings:gaming-gamebar" Click="OpenSettings"/><Button Content="Stampanti" Tag="ms-settings:printers" Click="OpenSettings"/><Button Content="Rete" Tag="ms-settings:network-status" Click="OpenSettings"/></UniformGrid>
    <Button Content="Apri cartella dei dati locali" Click="OpenData" HorizontalAlignment="Left" Margin="4,24,4,4"/>
    <TextBlock Text="Hub non richiede un account e conserva le preferenze su questo PC. Per uscire completamente usa il menu dell’icona nell’area notifiche." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="4,12"/>
   </StackPanel></ScrollViewer></Border></TabItem>
  </TabControl>
  <TextBlock x:Name="Status" Grid.Row="2" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,16,0,0" Text="Preparazione…" TextWrapping="Wrap"/>
 </Grid>
</Window>
